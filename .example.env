APP_DEBUG = true
DEFAULT_LANG = zh-cn
# 站点访问地址（安装器会自动写入，也可手动维护）
HOST =
# 应用密钥，请替换为随机 32 位以上字符串，切勿使用示例值
APP_KEY =
# WebSocket 对外地址，留空则由安装器根据 HOST 生成
WEBSOCKET_SERVER_URL =

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
DRIVER = mysql
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = rabshop
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = lf_
DEBUG = false

[REDIS]
HOSTNAME = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0
PREFIX = manage
TAG_PREFIX = manage_tag_

[QUEUE]
NAME = manage
